# /etc/portal/scanner.env — see portal-api env for the general pattern.
#
# Ansible overwrites this from the Vault on deploy.

# Portal API this scanner talks to (localhost when co-hosted).
PORTAL_API_URL=http://127.0.0.1:3000
PORTAL_API_KEY=CHANGE_ME

# Linode Object Storage source bucket for .dem files.
SCANNER_S3_BUCKET=portal-demos
SCANNER_S3_ENDPOINT=https://us-east-1.linodeobjects.com
SCANNER_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# CS2 demo parser (used to fetch stats for newly cataloged demos). REQUIRED —
# the scanner refuses to start without it, and there is no default. Point it at
# your own portal-demo-stats deployment behind TLS; it must be https and must
# not be a private/loopback host. Naming a third party here means every demo
# filename this scanner catalogs is sent to them.
CS2_DEMO_SERVICE_URL=https://demos.CHANGE_ME

# Game the cataloged demos belong to (UUID from the games table). REQUIRED —
# the scanner refuses to start without it.
SCANNER_GAME_ID=CHANGE_ME

# Scan + pending-processing cadence.
SCANNER_INTERVAL_SECS=300
SCANNER_PROCESSING_INTERVAL_SECS=60

# Loopback Prometheus exporter (never public; empty/unset = disabled).
# The portal box uses 9465 (deploy docs: observability-design.md §3).
#METRICS_ADDR=127.0.0.1:9465

RUST_LOG=portal_scanner=info
