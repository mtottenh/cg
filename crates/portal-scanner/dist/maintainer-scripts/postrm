#!/bin/sh
set -e

case "$1" in
    purge)
        # Only on `dpkg --purge portal-scanner`. /etc/portal and the
        # `portal` user are shared with portal-api, portal-demo-stats and
        # portal-steam-bot when co-hosted: remove only what this package
        # owns; drop the shared user only when no other portal package
        # remains. /etc/portal/agent-ca is never touched by any package.
        rm -f /etc/portal/scanner.env
        rmdir /etc/portal 2>/dev/null || true

        others=""
        for pkg in portal-api portal-demo-stats portal-steam-bot; do
            if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q ' installed$'; then
                others="$others $pkg"
            fi
        done
        if [ -n "$others" ]; then
            echo "portal-scanner: keeping /etc/portal and the portal user (still used by:$others)"
        else
            if getent passwd portal >/dev/null; then
                deluser --quiet --system portal || true
            fi
            if getent group portal >/dev/null; then
                delgroup --quiet --system portal 2>/dev/null || true
            fi
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1\`" >&2
        exit 1
        ;;
esac

